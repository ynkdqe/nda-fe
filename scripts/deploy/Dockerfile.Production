# syntax=docker/dockerfile:1.7
FROM node:22-slim AS builder

ARG APP_NAME=web-naive
ARG PACKAGE_FILTER=@vben/web-naive
ARG BUILD_MODE=production

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV NODE_OPTIONS=--max-old-space-size=8192
ENV TZ=Asia/Ho_Chi_Minh
ENV CI=true

WORKDIR /app

RUN corepack enable && pnpm config set store-dir /pnpm/store

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .node-version ./
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm fetch --frozen-lockfile

COPY . .

# Dung --prefer-offline chu khong phai --offline: store nam trong cache mount cua
# BuildKit, con cache record cua buoc `pnpm fetch` lai nam trong layer image. Hai thu
# nay bi don doc lap nhau. Khi cache mount bi duoi (gioi han dung luong, prune, hoac
# build tren agent moi) ma layer fetch van cache-hit thi fetch bi bo qua, store rong,
# va --offline cam tai ve -> ERR_PNPM_NO_OFFLINE_TARBALL. --prefer-offline van uu tien
# store khi con, chi tai lai phan thieu.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --prefer-offline
RUN test -f apps/${APP_NAME}/.env.${BUILD_MODE}
RUN pnpm --filter ${PACKAGE_FILTER} exec vite build --mode ${BUILD_MODE}

FROM nginx:stable-alpine AS runtime

ARG APP_NAME=web-naive

ENV TZ=Asia/Ho_Chi_Minh

RUN rm -rf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/apps/${APP_NAME}/dist /usr/share/nginx/html
COPY --from=builder /app/scripts/deploy/nginx.conf /etc/nginx/nginx.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
